# The app's single origin: static build at /, backend at /api and /health.
#
# ${WEB_SERVER_NAME} and the two certificate paths are substituted by the
# nginx image's entrypoint at boot — they are the only things that differ
# between the LAN (a locally generated CA) and the VPS (Let's Encrypt).

# Plain http exists only to send phones to https: a service worker will not
# register without a secure context, so the app is not an app over http.
server {
    listen 80;
    listen [::]:80;
    server_name ${WEB_SERVER_NAME};

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${WEB_SERVER_NAME};

    ssl_certificate ${TLS_CERT_FILE};
    ssl_certificate_key ${TLS_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:2m;

    root /usr/share/nginx/html;
    index index.html;

    # 8 photos of up to 10MB each (MAX_IMAGES × MAX_BYTES_PER_IMAGE in
    # backend/app/services/image_intake.py), plus multipart overhead. Set
    # above the backend's own limit on purpose: a photo that is too large
    # should come back with the backend's Portuguese message, not with
    # nginx's bare 413.
    client_max_body_size 88m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;
    gzip_min_length 1024;

    # Docker's embedded DNS, consulted at request time because the upstream
    # is reached through a variable below — a backend container that comes
    # back with a new address is then picked up on its own, instead of
    # 502-ing until nginx is reloaded.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend http://backend:8000;

    location /api/ {
        proxy_pass $backend$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The video door is the longest request in the app — metadata,
        # audio download, speech-to-text, then two model passes — and
        # nginx's 60s default would cut the response off mid-extraction.
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        # Extraction answers in one shot after minutes of work; buffering it
        # adds nothing and only delays the loader's ending.
        proxy_buffering off;
    }

    location = /health {
        proxy_pass $backend$request_uri;
        proxy_set_header Host $host;
        access_log off;
    }

    # nginx's mime.types knows no .webmanifest, and would hand the file over
    # as application/octet-stream. `types {}` empties the map for this one
    # location so default_type is what answers.
    location = /manifest.webmanifest {
        types { }
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    # The service worker and the entry point must never be served stale, or
    # the app pins itself to an old build: index.html names the hashed
    # bundles, and sw.js decides when to fetch a new one.
    location ~* ^/(index\.html|sw\.js|registerSW\.js)$ {
        add_header Cache-Control "no-cache";
    }

    # Everything under /assets carries a content hash in its name, so it can
    # never go stale — a changed file is a different URL.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Client-side routes (/adicionar, /recipes/:id) have no file behind them.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
