# Copy this file to .env and fill in real values. Never commit .env.
# There are no working defaults on purpose — pick your own credentials below.

# Postgres (used by docker-compose to build the containers' connection strings)
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cozinia

# Full connection strings for running the backend directly on the host
# (outside Docker) — e.g. `pytest`, `alembic`. Must use the same credentials
# as POSTGRES_USER/PASSWORD above, but "localhost" instead of the "db"
# hostname, since "db" only resolves inside the Docker network.
DATABASE_URL=postgresql+asyncpg://changeme:changeme@localhost:5432/cozinia
TEST_DATABASE_URL=postgresql+asyncpg://changeme:changeme@localhost:5432/cozinia_test

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# OpenRouter model slug used for recipe extraction — swap models by changing
# this value only, no code change required (see docs/ARCHITECTURE.md).
AI_MODEL=anthropic/claude-sonnet-5

# Model used to read recipes out of uploaded photos. Kept separate from
# AI_MODEL because it must be vision-capable, and the model you pick for
# text extraction may not be. Only this one ever receives images.
AI_VISION_MODEL=anthropic/claude-sonnet-5

# Model that turns a video's material — its written description plus the
# transcript of what is narrated — into one clean recipe document, before
# AI_MODEL extracts the structured fields from it. Kept separate because that
# job is long, noisy input and needs stronger instruction-following.
AI_VIDEO_MODEL=anthropic/claude-sonnet-5

# Speech-to-text model, used only when a video has no subtitles to read and
# its audio has to be transcribed. This one goes to OpenRouter's
# /audio/transcriptions endpoint, which accepts transcription models only —
# a chat model here will not work.
AI_AUDIO_MODEL=openai/whisper-1

# Model used to translate an already-extracted recipe into Brazilian
# Portuguese and convert its measurements to metric units, when it wasn't
# extracted in Portuguese to begin with. Kept separate from AI_MODEL because
# it follows a longer, more specific instruction than plain extraction does.
AI_TRANSLATION_MODEL=anthropic/claude-sonnet-5

# Optional. Path (inside the backend container) to a Netscape cookies.txt for
# yt-dlp. Only needed if a platform starts refusing anonymous requests from
# the server — Instagram and TikTok are the usual culprits. Leave unset for
# normal use: a cookies file is a live credential to a personal account.
# VIDEO_COOKIES_FILE=/run/secrets/video_cookies.txt

# Optional. Leave unset for normal use: the frontend derives the API address
# from whatever host served the page (localhost on this machine, the LAN IP
# when opened from a phone), so testing from a phone needs no configuration.
# Only set this to point the frontend at a backend on a *different* host.
# VITE_API_URL=http://192.168.0.10:8000
