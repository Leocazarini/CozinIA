# Copy this file to .env and fill in real values. Never commit .env.

# Postgres (used by the db and backend services)
POSTGRES_USER=cozinia
POSTGRES_PASSWORD=cozinia
POSTGRES_DB=cozinia

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# OpenRouter model slug used for recipe extraction — swap models by changing
# this value only, no code change required (see docs/ARCHITECTURE.md).
AI_MODEL=anthropic/claude-sonnet-5
