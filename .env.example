# Copy this file to .env and fill in real values. Never commit .env.
# There are no working defaults on purpose — pick your own credentials below.

# Postgres (used by docker-compose to build the containers' connection strings)
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cozinia

# Full connection strings for running the backend directly on the host
# (outside Docker) — e.g. `pytest`, `alembic`. Must use the same credentials
# as POSTGRES_USER/PASSWORD above, but "localhost" instead of the "db"
# hostname, since "db" only resolves inside the Docker network.
DATABASE_URL=postgresql+asyncpg://changeme:changeme@localhost:5432/cozinia
TEST_DATABASE_URL=postgresql+asyncpg://changeme:changeme@localhost:5432/cozinia_test

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# OpenRouter model slug used for recipe extraction — swap models by changing
# this value only, no code change required (see docs/ARCHITECTURE.md).
AI_MODEL=anthropic/claude-sonnet-5
